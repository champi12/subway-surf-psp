+// --- comprobacion de alineacion (como la CPU real de la PSP) si PPSSPP_STRICT_ALIGN esta definido ---
+static inline void SS_AlignCheck(u32 addr, u32 a, const char *what) {
+	static int strict = -1;
+	if (strict < 0) { strict = getenv("PPSSPP_STRICT_ALIGN") != nullptr; fprintf(stderr, "SS_AlignCheck activo=%d\n", strict); }
+	if (strict && (addr & (a - 1))) {
+		fprintf(stderr, "UNALIGNED %s addr %08x PC %08x RA %08x\n", what, addr, currentMIPS->pc, currentMIPS->r[MIPS_REG_RA]);
+		fflush(stderr);
+		Core_Break(currentMIPS->pc);
+	}
+}
