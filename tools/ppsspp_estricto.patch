+	// --- PPSSPP_STRICT_FPU: avisa de las operaciones que en la PSP real levantan una excepcion de la FPU
+	// (division por cero, operacion invalida -> NaN, desbordamiento -> infinito, comparacion con NaN) ---
+	static void SS_FpuReport(const char *what, float a, float b, float r) {
+		static int strict = -1, count = 0;
+		if (strict < 0) { strict = getenv("PPSSPP_STRICT_FPU") != nullptr; fprintf(stderr, "SS_FpuCheck activo=%d\n", strict); }
+		if (!strict || count >= 4000) return;
+		static int all = getenv("PPSSPP_STRICT_FPU_ALL") != nullptr;   // avisar aunque esten desactivadas
+		if (!all && !(currentMIPS->fcr31 & 0x00000E00)) return;   // como la PSP: solo si estan activadas (V, Z u O)
+		static unsigned seen[256]; static int nseen; for (int i = 0; i < nseen; i++) if (seen[i] == currentMIPS->pc) return; if (nseen < 256) seen[nseen++] = currentMIPS->pc;
+		count++;
+		fprintf(stderr, "SS_FPU %s en PC=%08x RA=%08x FCR31=%08x: a=%g b=%g -> %g\n", what, currentMIPS->pc, currentMIPS->r[31], currentMIPS->fcr31, a, b, r);
+	}
+	static inline void SS_Fpu3(int opn, float a, float b, float r) {
+		if (my_isnan(a) || my_isnan(b)) { SS_FpuReport("operando NaN", a, b, r); return; }
+		if (opn == 3 && b == 0.0f) { SS_FpuReport(a == 0.0f ? "0/0 (invalida)" : "division por cero", a, b, r); return; }
+		if (my_isnan(r)) { SS_FpuReport("operacion invalida (NaN)", a, b, r); return; }
+		if (my_isinf(r) && !my_isinf(a) && !my_isinf(b)) SS_FpuReport("desbordamiento (infinito)", a, b, r);
+	}
